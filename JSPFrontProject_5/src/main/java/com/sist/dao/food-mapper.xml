<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.dao.food-mapper">
	<select id="foodListData" resultType="FoodVO" parameterType="int">
		SELECT no, poster, name
		FROM food
		ORDER BY no ASC
		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
	</select>
	<!-- 
		인라인 : rownum은 TOP-N (처음부터 ~, 중간 값은 가지고 올 수 없다)
		SELECT no, poster, name, num
		FROM (SELECT no, poster, name, rownum as sum
		FROM (SELECT no, poster, name
		FROM food ORDER BY no ASC))
		WHERE num BETWEEN #{start} AND #{end}
		
		MySQL
		SELECT no, poster, name
		FROM food 
		ORDER BY no ASC
		LIMIT ?, 12
	 -->
	 <select id="foodTotalPage" resultType="int">
	 	SELECT CEIL(COUNT(*)/12.0) FROM food
	 </select>
	 <!-- 
	 	parameterType="int" setInt()
	 	parameterType="string" setString()
	 	parameterType="hashmap"
	 	Map map=new HashMap()
	 	map.put("start",1)
	 	map.put("end",10)
	 	start=#{start} AND end=#{end}
	 		map.get("start") map.get("end")
	 	parameterType="FoodVO"
	 	insert into food value(#{name},#{poster}...)
	 							vo.getName() vo.getPoster()
	  -->
	 <select id="foodDetailData" resultType="FoodVO" parameterType="int">
	 SELECT * 
	 FROM food
	 WHERE no=#{no}
	 </select>
	 
</mapper>