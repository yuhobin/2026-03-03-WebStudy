<mapper namespace="com.sist.mapper.food-mapper">

	<!-- 맛집 목록 -->
	<select id="foodListData" resultType="FoodVO" parameterType="int">
		<!-- 
			id / resultType parameterType resultMap
											| 원하는 방식으로 값을 채운다 (JOIN)
								| ?에 값 설정
					| 값을 저장하는 데이터 
			 | 구분자 = 중복되면 안된다 (Primary)
			 String sql="SELECT ~" 				=> SQL 문장
			 ps=conn.preparedStatement(sql)
			 ps.setint(1, 값)					=> ?에 값은
			 ResultSet rs=ps.executeQuery()
			 while(rs.next()) {
			 	FoodVO vo=new FoodVO(); 		 => 어디에 데이터를 저장
			 	co.setNo(rs.getInt(1));
			 	..
			 	..
			 }
			 1. mapper.xml 파싱 => 필요한 데이터를 읽기
			 	<select id="foodListData" parameterType="int" resultType="FoodVO>
			 											  | setInt()
			 											 String
			 											  | setString() => ''
			 		SELECT *
			 		FROM food
			 		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
			 	</select>
		 -->
		SELECT no, poster, name, address
		FROM food
		ORDER BY no ASC
		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
	</select>
	
	<!-- 총페이지  -->
	<select id="foodTotalPage" resultType="int">
		SELECT CEIL(COUNT(*)/12.0) FROM food
	</select>
	
	<!-- 상세보기 -->
	<select id="foodDetailData" resultType="FoodVO" parameterType="int">
		SELECT * 
		FROM food
		WHERE no=#{no}
	</select>
</mapper>