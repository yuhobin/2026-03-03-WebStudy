<?xml version="1.0" encoding="UTF-8"?>
<!-- 
	확장된 ML => 지원하는 태그는 없다 => 사용자 정의 => 시멘텍 태그 
	=> 알아보기 쉽게 만든 태그 
	=> XML을 이용하는 라이브러리 
		1) Spring : 환경설정 / 라이브러리 => m2 (pom.xml)
								| 배포 / 프로젝트 / 버전관리 => maven (SpringFramework)
								| gradle : property => Spring-boot
		2) MyBatis : SQL문장 / 환경 설정 (데이터베이스)
	=> XML 문서
		=> 문서형 데이터베이스 (B2B)
		=> XML 문법이 강력하다
			1) 트리형태의 프로그램 => 루트태그가 반드시 있다 (한개만 존재)
			2) 여는 태그 / 닫는 태그 일치 
				닫느 태그가 없는 경우 : <태그/>
				** React는 jsx / tsx => 문법을 xml
			3) 대소문자 구분 
			4) 속성값이 있는 경우 : 속성=""
			5) 태그/속성을 사용자 정의 
				태그명, 속성명은 반드시 문자로 시작한다
			6) XML의 형식을 문서화 => dtd (HTML, MyBatis)
		=> 설저 파일 / 등록 (클래스 등록..)
		=> XML을 파싱 => 저장된 데이터 추출
		   =========> SAX / DOM
		   				   ===== 데이터베이스 역할
		   				   ===== 메머리에 저장 후 제어
		   			 ==== MyBatis / Spring
		   			 	  ======= 한줄씩 읽어서 데이터 추출
		   *** 라이브러리는 이미 파싱처리가 된다
		   XML = 무겁다 (전송시에 속도가 느려진다)
		   		=> XML을 대체하는 파일 => JSON
 -->		
 <sawon><!-- 테이블명  -->
 	<list> <!-- ROW -->
 		<sabun>1</sabun>
 		<name>홍길동</name> <!-- 컬럼명 -->
 		<dept>개발부</dept>
 		<job>대리</job>
 		<loc>서울</loc>
 	</list>
 	<list>
 		<sabun>2</sabun>
 		<name>심청이</name>
 		<dept>인사부</dept>
 		<job>과장</job>
 		<loc>서울</loc>
 	</list>
 </sawon>